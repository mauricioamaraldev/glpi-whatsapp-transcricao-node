# URL base da API REST do GLPI (ex: https://glpi.suainstituicao.edu.br/apirest.php)
GLPI_API_URL=

# App-Token gerado em Configuração > API do GLPI
GLPI_APP_TOKEN=

# User-Token de um usuário com permissão de API no GLPI
GLPI_USER_TOKEN=

# Chave da API Groq (https://console.groq.com)
GROQ_API_KEY=
